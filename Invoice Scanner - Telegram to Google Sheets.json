    {
      "parameters": {
        "jsCode": "// Parse Gemini's JSON response and merge with our tracking fields\nconst response = items[0].json;\nlet text = response.candidates[0].content.parts[0].text.trim();\ntext = text.replace(/```json|```/g, '').trim();\n\nlet data;\ntry {\n  data = JSON.parse(text);\n} catch (e) {\n  data = { items: [], raw_notes: 'PARSE_ERROR: ' + text };\n}\n\nconst prep = $('Prepare Image2').first().json;\n\nreturn [{\n  json: {\n    invoice_local_id: prep.invoice_local_id,\n    processed_at: prep.processed_at,\n    chat_id: prep.chat_id,\n    invoice_number: data.invoice_number || '',\n    date: data.date || '',\n    store_name: data.store_name || '',\n    store_phone: data.store_phone || '',\n    customer_name: data.customer_name || '',\n    customer_address: data.customer_address || '',\n    sales_rep: data.sales_rep || '',\n    invoice_total: data.invoice_total || 0,\n    previous_balance: data.previous_balance || 0,\n    paid_cash: data.paid_cash || 0,\n    current_balance: data.current_balance || 0,\n    raw_notes: data.raw_notes || '',\n    item_count: (data.items || []).length,\n    items: data.items || []\n  }\n}];"
      },
