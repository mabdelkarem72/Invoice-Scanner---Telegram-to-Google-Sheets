    {
      "parameters": {
        "jsCode": "// Read the actual binary buffer using n8n's helper (works regardless of\n// whether binary data is stored in memory, filesystem, or S3)\nconst binaryPropertyName = 'data';\nconst buffer = await this.helpers.getBinaryDataBuffer(0, binaryPropertyName);\nconst base64 = buffer.toString('base64');\nconst mimeType = items[0].binary[binaryPropertyName].mimeType || 'image/jpeg';\n\nconst now = new Date();\nconst invoiceLocalId = 'INV-' + now.getTime();\n\nreturn [{\n  json: {\n    invoice_local_id: invoiceLocalId,\n    processed_at: now.toISOString(),\n    mime_type: mimeType,\n    image_base64: base64,\n    chat_id: $('Telegram Trigger2').first().json.message.chat.id\n  }\n}];"
      },
      "id": "9f42c861-417b-4010-a103-28f7403c360e",
      "name": "Prepare Image2",
